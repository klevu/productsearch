<?php /** @var \Klevu\Search\Block\Adminhtml\Form\Field\Sync\Button $block */ ?>
<button id="<?= /** @noEscape */ $block->getDataUsingMethod('html_id') ?>" class="scalable" type="button">
    <span><?= $block->escapeHtml(__($block->getDataUsingMethod('button_label'))); ?></span>
</button>

<script type="text/javascript">
    require(["prototype"], function () {
        $("<?= /** @noEscape */ $block->getHtmlId() ?>").observe("click", function () {
            if (document.getElementById('klevu_integration_next_steps_sync')) {
                new Ajax.Request("<?= $block->escapeUrl($block->getAjaxUrl()) ?>", {
                    method: 'POST',
                    onComplete: function (data) {
                        if (parseInt(<?= $block->escapeHtml($block->getSyncOptions()?: '')?>) === 1) {
                            window.open("<?= $block->escapeUrl($block->getSyncUrlForStore()); ?>", "_blank");
                        } else {
                            setLocation("<?= $block->escapeUrl($block->getDataUsingMethod('destination_url')) ?>");
                        }
                    }
                });
            } else {
                setLocation("<?= $block->escapeUrl($block->getDataUsingMethod('destination_url')) ?>");
            }
        });
    });
</script>
